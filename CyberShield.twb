    <dashboard name='2. THREAT INTELLIGENCE'>
      <style>
        <style-rule element='dashboard'>
          <format attr='background-color' value='#0a0f1d' />
        </style-rule>
      </style>
      <size maxheight='950' maxwidth='1600' minheight='950' minwidth='1600' />
      <zones>
        <zone h='100000' id='1' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='9500' id='2' type='text' w='98500' x='750' y='500'>
