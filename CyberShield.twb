            <column datatype='string' name='[display_text]' role='dimension' type='nominal' />
            <column datatype='string' name='[color_tier]' role='dimension' type='nominal' />
            <column-instance column='[item_label]' derivation='None' name='[none:item_label:nk]' pivot='key' type='nominal' />
            <column-instance column='[bar_value]' derivation='Sum' name='[sum:bar_value:qk]' pivot='key' type='quantitative' />
            <column-instance column='[display_text]' derivation='None' name='[none:display_text:nk]' pivot='key' type='nominal' />
            <column-instance column='[color_tier]' derivation='None' name='[none:color_tier:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='table'>
            <format attr='background-color' value='#11192d' />
            <format attr='band-size' scope='rows' value='1' />
            <format attr='band-size' scope='cols' value='1' />
            <format attr='omit-on-special' value='false' />
            <format attr='break-on-special' value='false' />
            <format attr='show-null-value-warning' value='false' />
